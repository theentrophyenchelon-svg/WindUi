{
    "name": "windui-godtier-plus",
    "version": "1.8.0-godtier-plus",
    "main": "./dist/main.lua",
    "godtierPlus": "./dist/godtier_plus.lua",
    "repository": "https://github.com/theentrophyenchelon-svg/WindUi",
    "author": "theentrophyenchelon-svg",
    "description": "Premium Roblox Luau UI library with GodTier Plus visuals, motion profiles, theme studio tools, loading overlays, performance stats, and polished components",
    "license": "MIT",
    "scripts": {
        "dev": "bash build/build.sh dev $INPUT_FILE",
        "build": "bash build/build.sh build $INPUT_FILE",
        "live": "python3 -m http.server 8642",
        "watch": "chokidar . -i 'node_modules' -i 'dist' -i 'build' -c 'npm run dev --'",
        "live-build": "concurrently \"npm run live\" \"npm run watch --\"",
        "example-live-build": "INPUT_FILE=main_example.lua npm run live-build",
        "updater": "python3 updater/main.py"
    },
    "keywords": [
        "roblox",
        "luau",
        "ui-library",
        "interface",
        "themes",
        "animations",
        "performance",
        "windui",
        "godtier"
    ],
    "devDependencies": {
        "chokidar-cli": "^3.0.0",
        "concurrently": "^9.2.0"
    }
}
