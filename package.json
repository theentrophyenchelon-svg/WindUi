{
    "name": "sentry-hub-library",
    "version": "2.2.0-contained-live",
    "main": "./dist/main.lua",
    "productionLayer": "./dist/sentry_production.lua",
    "fallbackExtension": "./dist/godtier_plus.lua",
    "repository": "https://github.com/theentrophyenchelon-svg/WindUi",
    "author": "theentrophyenchelon-svg",
    "description": "Contained production-grade Roblox Luau UI framework with sectioned tabs, live-updating console logs, profile card, friend stats, performance monitor, theme studio, decal image preview, intro flow, highlights, strokes, and glow feedback",
    "license": "MIT",
    "scripts": {
        "dev": "bash build/build.sh dev $INPUT_FILE",
        "build": "bash build/build.sh build $INPUT_FILE",
        "live": "python3 -m http.server 8642",
        "watch": "chokidar . -i 'node_modules' -i 'dist' -i 'build' -c 'npm run dev --'",
        "live-build": "concurrently \"npm run live\" \"npm run watch --\"",
        "example-live-build": "INPUT_FILE=main_example.lua npm run live-build",
        "updater": "python3 updater/main.py"
    },
    "keywords": [
        "roblox",
        "luau",
        "ui-library",
        "contained-ui",
        "sections",
        "live-updating",
        "console-log",
        "friend-system",
        "theme-studio",
        "decal-preview",
        "intro",
        "performance",
        "sentry"
    ],
    "devDependencies": {
        "chokidar-cli": "^3.0.0",
        "concurrently": "^9.2.0"
    }
}
